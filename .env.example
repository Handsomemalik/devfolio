# ==============================================================================
# FolioNova Environment Configuration
# ==============================================================================

# Public Supabase API credentials (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Supabase Service Role key (NEVER expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Site root URL for metadata, share links, and callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
